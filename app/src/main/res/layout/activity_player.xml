<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Video Stage Container (16:9 or Fullscreen) -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

        <!-- Modern High-Performance ExoPlayer / Media3 PlayerView -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/exoPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:resize_mode="fit"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <!-- Fallback VideoView for legacy direct files if needed -->
        <VideoView
            android:id="@+id/nativeVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Fallback / Embedded Stream Web Engine -->
        <WebView
            android:id="@+id/playerWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:visibility="gone" />

        <!-- Initial Poster Backdrop while buffering -->
        <ImageView
            android:id="@+id/imgPlayerPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.35"
            android:contentDescription="Poster"
            android:scaleType="centerCrop" />

        <!-- Fast Loading / Buffering Spinner -->
        <LinearLayout
            android:id="@+id/playerLoadingView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="#D9141414"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp"
            android:visibility="visible">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/netflix_red" />

            <TextView
                android:id="@+id/tvPlayerLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-black"
                android:text="Fast Stream Buffering..."
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPlayerLoadingSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:text="Hardware-Accelerated Ultra Fast Response"
                android:textColor="@color/netflix_gold"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Double-Tap / Slide Visual Indicators for 10s Rewind / Forward -->
        <LinearLayout
            android:id="@+id/indicatorRewind10"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="40dp"
            android:background="@drawable/bg_seek_indicator"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Rewind"
                android:src="@drawable/ic_replay_10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:text="-10s"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/indicatorForward10"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="40dp"
            android:background="@drawable/bg_seek_indicator"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Forward"
                android:src="@drawable/ic_forward_10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:text="+10s"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Custom Interactive Cinema Controls Overlay -->
    <RelativeLayout
        android:id="@+id/layoutControlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:id="@+id/topPlayerBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:background="#CC0A0A0A"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/btnPlayerBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toStartOf="@id/topBarActions"
                android:layout_toEndOf="@id/btnPlayerBack"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPlayerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:text="Movie Title"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvPlayerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Ultra-Fast Cinema Engine • Instant Seek"
                    android:textColor="@color/netflix_gold"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topBarActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnOpenExternalPlayer"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="External Player"
                    android:padding="8dp"
                    android:src="@drawable/ic_open_in_new" />

                <TextView
                    android:id="@+id/playerQualityTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_top10_badge"
                    android:fontFamily="sans-serif-black"
                    android:text="FAST PLAY"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <!-- Top Bar Close Button (Clean Circular Icon) -->
                <FrameLayout
                    android:id="@+id/btnClosePlayer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Close Player"
                        android:src="@drawable/ic_close" />
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Center Controls: 10s Rewind | Instant Play/Pause | 10s Forward -->
        <LinearLayout
            android:id="@+id/centerControlsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Rewind 10 Seconds -->
            <LinearLayout
                android:id="@+id/btnRewind10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Rewind 10s"
                    android:src="@drawable/ic_replay_10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="-10s"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Main High-Speed Play / Pause Button (Circular Cinema Red) -->
            <FrameLayout
                android:id="@+id/btnMainPlayPause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_cinema_play_circle"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgMainPlayPause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="Play/Pause"
                    android:src="@drawable/ic_pause" />
            </FrameLayout>

            <!-- Forward 10 Seconds -->
            <LinearLayout
                android:id="@+id/btnForward10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Forward 10s"
                    android:src="@drawable/ic_forward_10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="+10s"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Adsterra 468x60 Pause Ad Card (Displayed cleanly when video is paused) -->
        <FrameLayout
            android:id="@+id/layoutPlayerPauseAd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/bottomPlayerControls"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card_movie"
            android:elevation="20dp"
            android:padding="2dp"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <WebView
                    android:id="@+id/webPlayerPauseAd"
                    android:layout_width="380dp"
                    android:layout_height="64dp"
                    android:background="@android:color/transparent" />

                <!-- Close Button for Pause Ad -->
                <ImageView
                    android:id="@+id/btnClosePauseAd"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/bg_floating_close"
                    android:contentDescription="Close Ad"
                    android:padding="3dp"
                    android:src="@drawable/ic_close" />
            </RelativeLayout>
        </FrameLayout>

        <!-- Bottom Controls, 10s Slide Jump Buttons & Timeline -->
        <LinearLayout
            android:id="@+id/bottomPlayerControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#E60A0A0A"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- 10-Second Slides Action Buttons Bar -->
            <LinearLayout
                android:id="@+id/layoutSlideButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="10S SLIDE &amp; JUMP:"
                    android:textColor="@color/netflix_gold"
                    android:textSize="11sp" />

                <!-- Slide -10s Button -->
                <LinearLayout
                    android:id="@+id/btnSlideRewind10"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_quick_seek_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Slide -10s"
                        android:src="@drawable/ic_replay_10" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="◀ 10s Slide"
                        android:textColor="@color/white"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Mini Play/Pause Quick Toggle -->
                <LinearLayout
                    android:id="@+id/btnMiniPlayPause"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_quick_seek_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgMiniPlayPause"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Play/Pause"
                        android:src="@drawable/ic_pause" />

                    <TextView
                        android:id="@+id/tvMiniPlayPause"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Pause"
                        android:textColor="@color/white"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Slide +10s Button -->
                <LinearLayout
                    android:id="@+id/btnSlideForward10"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_quick_seek_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="10s Slide ▶"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Slide +10s"
                        android:src="@drawable/ic_forward_10" />
                </LinearLayout>
            </LinearLayout>

            <!-- Timeline Scrub Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="00:00"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/playerSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressBackgroundTint="#444444"
                    android:progressTint="@color/netflix_red"
                    android:thumbTint="@color/netflix_red" />

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="--:--"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/btnFullscreenToggle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Fullscreen"
                    android:padding="4dp"
                    android:src="@drawable/ic_fullscreen" />
            </LinearLayout>

            <!-- Extra rows: Quality Switcher & Action buttons (compacted in landscape) -->
            <LinearLayout
                android:id="@+id/layoutPlayerExtraRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Quality Switcher Server Row -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="DIRECT STREAM QUALITY:"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutQualityButtons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <!-- Quality Buttons populated dynamically -->
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Fast Action Buttons (Download & Details) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDownloadMovie"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cinema_button_red"
                        android:drawableStart="@drawable/ic_play_arrow"
                        android:drawablePadding="6dp"
                        android:fontFamily="sans-serif-black"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Download Movie"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnOpenWebArticle"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_netflix_button_dark"
                        android:drawableStart="@drawable/ic_open_in_new"
                        android:drawablePadding="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Movie Details"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
